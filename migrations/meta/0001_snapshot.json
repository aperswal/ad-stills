      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "ad_range": {
          "name": "ad_range",
          "value": "\"ads\".\"position\" BETWEEN 0 AND 9 AND \"ads\".\"width\">0 AND \"ads\".\"height\">0 AND \"ads\".\"width\"*\"ads\".\"height\"<=40000000 AND \"ads\".\"attempt\">=0 AND \"ads\".\"updated_at\">=0"
        },
        "ad_state": {
          "name": "ad_state",
          "value": "\"ads\".\"state\" IN ('queued','running','done','failed')"
        },
        "ad_claim": {
          "name": "ad_claim",
          "value": "(\"ads\".\"state\"='running' AND \"ads\".\"claimed_by\" IS NOT NULL AND \"ads\".\"claimed_at\" IS NOT NULL) OR (\"ads\".\"state\"<>'running' AND \"ads\".\"claimed_by\" IS NULL AND \"ads\".\"claimed_at\" IS NULL)"
        },
        "ad_result": {
          "name": "ad_result",
          "value": "(\"ads\".\"state\"='done' AND \"ads\".\"result_key\" IS NOT NULL AND \"ads\".\"copy\" IS NOT NULL AND json_valid(\"ads\".\"copy\")) OR (\"ads\".\"state\"<>'done' AND \"ads\".\"result_key\" IS NULL AND \"ads\".\"copy\" IS NULL)"
        },
        "ad_failure": {
          "name": "ad_failure",
          "value": "(\"ads\".\"state\"='failed' AND length(\"ads\".\"failure_reason\") BETWEEN 1 AND 1000) OR (\"ads\".\"state\"<>'failed' AND \"ads\".\"failure_reason\" IS NULL)"
        },
        "ad_note": {
          "name": "ad_note",
          "value": "length(\"ads\".\"extra_note\")<=2000"
        },
        "ad_keys": {
          "name": "ad_keys",
          "value": "substr(\"ads\".\"original_key\",1,54) = 'batches/' || \"ads\".\"batch_id\" || '/original/' AND (\"ads\".\"result_key\" IS NULL OR substr(\"ads\".\"result_key\",1,52) = 'batches/' || \"ads\".\"batch_id\" || '/result/')"
        }
      }
    },
